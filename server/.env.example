# JWT Authentication secret key
JWT_SECRET=your_jwt_secret_here

# MongoDB database connection string URI
MONGODB_URI=mongodb://localhost:27017/my_database

# Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# ImageKit configuration settings for image storage/processing
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key_here
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here
IMAGEKIT_URL_ENDPOINT=your_imagekit_url_endpoint_here

# Razorpay key details for payment processing
RAZORPAY_PUBLISHABLE_KEY=your_razorpay_publishable_key_here
RAZORPAY_SECRET_KEY=your_razorpay_secret_key_here

# Application server and client URL configuration
BACKEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173

# Optional configuration settings for Room Collab Chat
ROOM_INVITE_EXPIRY_DAYS=7
AI_CONTEXT_DEPTH=20
SUMMARY_COOLDOWN_SECONDS=60

# Vector Database (Pinecone) configuration for RAG
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=mygpt-index

# Python RAG microservice bridge (Phase 1–3)
PYTHON_RAG_URL=http://127.0.0.1:8000
PYTHON_RAG_TIMEOUT_MS=15000
PYTHON_RAG_LLM_TIMEOUT_MS=45000
